// KIEN Sports - Prisma schema
// Money is stored as INTEGER PAISE (1 INR = 100 paise) for exactness.
// The public API exposes rupee integers to match the existing frontend.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- users

enum RoleName {
  CUSTOMER
  ADMIN
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  emailVerifiedAt  DateTime?
  isActive         Boolean  @default(true)
  failedLogins     Int      @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  roles          UserRole[]
  addresses      Address[]
  orders         Order[]
  reviews        Review[]
  wishlistItems  WishlistItem[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  carts          Cart[]

  @@index([email])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
}

model Role {
  id   String   @id @default(cuid())
  name RoleName @unique
  users UserRole[]
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  label      String  @default("Home")
  firstName  String
  lastName   String
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  phone      String
  isDefault  Boolean @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------- catalog

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  world       String  // 'sport' | 'lifestyle' (open for future worlds)
  description String
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  products Product[]
}

model Collection {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String
  isActive    Boolean @default(true)

  products Product[]
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  shortDescription String
  description      String
  categoryId       String
  collectionId     String?
  status           ProductStatus @default(DRAFT)
  // paise
  pricePaise       Int
  compareAtPaise   Int?
  isFeatured       Boolean       @default(false)
  isNewArrival     Boolean       @default(false)
  isBestSeller     Boolean       @default(false)
  dimensions       String?
  weightGrams      Int?
  capacity         String?
  materials        String[]
  tags             String[]
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  images     ProductImage[]
  features   ProductFeature[]
  variants   ProductVariant[]
  reviews    Review[]
  wishlistItems WishlistItem[]
  couponProducts CouponProduct[]

  @@index([categoryId])
  @@index([status, isFeatured])
  @@index([status, isNewArrival])
}

model ProductImage {
  id           String  @id @default(cuid())
  productId    String
  url          String
  alt          String?
  colorName    String?
  sortOrder    Int     @default(0)
  mediaType    String  @default("IMAGE") // IMAGE | VIDEO
  publicId     String? // Cloudinary public id (hosted assets only)
  resourceType String? // "image" | "video" (Cloudinary resource type)
  format       String? // e.g. jpg, png, webp, mp4, webm

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductFeature {
  id          String @id @default(cuid())
  productId   String
  title       String
  description String
  icon        String?
  sortOrder   Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id          String  @id @default(cuid())
  productId   String
  sku         String  @unique
  colorName   String
  colorHex    String
  size        String?
  pricePaise  Int?    // overrides product price when set
  isActive    Boolean @default(true)

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory Inventory?
  cartItems CartItem[]
  orderItems OrderItem[]
  wishlistItems WishlistItem[]

  @@index([productId])
}

model Inventory {
  variantId         String   @id
  availableQty      Int      @default(0)
  reservedQty       Int      @default(0)
  soldQty           Int      @default(0)
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt

  variant   ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@index([availableQty])
}

model InventoryMovement {
  id         String   @id @default(cuid())
  variantId  String
  deltaQty   Int
  type       String  // RESTOCK | SALE | RESERVE | RELEASE | ADJUST
  reference  String? // order number, admin action id, etc.
  actorId    String?
  createdAt  DateTime @default(now())

  inventory Inventory @relation(fields: [variantId], references: [variantId], onDelete: Cascade)

  @@index([variantId, createdAt])
}

// ---------------------------------------------------------------- cart

model Cart {
  id           String   @id @default(cuid())
  // Random opaque token stored in an httpOnly cookie
  sessionToken String   @unique
  userId      String?
  status      String   @default("ACTIVE") // ACTIVE | CONVERTED | ABANDONED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items CartItem[]

  @@index([userId])
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  variantId     String
  quantity      Int
  unitPricePaise Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
}

// ---------------------------------------------------------------- orders

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  COD_PENDING
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  userId        String?
  email         String
  status        OrderStatus @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus @default(PENDING)
  // all amounts in paise, snapshot at purchase time
  subtotalPaise Int
  discountPaise Int         @default(0)
  // Applied coupon snapshot: the code + id captured at checkout. Historical
  // order totals are immutable even if the coupon is edited/disabled later.
  couponId      String?
  couponCode    String?
  shippingPaise Int
  taxPaise      Int         @default(0)
  totalPaise    Int
  shippingAddress Json      // immutable snapshot of the address
  placedAt      DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  payments    Payment[]
  shipments   Shipment[]
  statusEvents OrderStatusEvent[]
  returnRequests ReturnRequest[]
  redemptions CouponRedemption[]

  coupon    Coupon?          @relation("OrderCoupon", fields: [couponId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  variantId      String?
  // snapshots - never rely on current product data
  productName    String
  productSlug    String
  sku            String
  colorName      String
  size           String?
  quantity       Int
  unitPricePaise Int
  lineTotalPaise Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusEvent {
  id         String   @id @default(cuid())
  orderId    String
  fromStatus String
  toStatus   String
  note       String?
  actorId    String?
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum PaymentMethod {
  CARD
  UPI
  COD
  NETBANKING
}

model Payment {
  id                String       @id @default(cuid())
  orderId           String
  provider          String       // 'razorpay' | 'mock' | ...
  providerOrderId   String?
  providerPaymentId String?
  method            PaymentMethod
  amountPaise       Int
  status            String       @default("CREATED") // CREATED | AUTHORIZED | CAPTURED | FAILED | REFUNDED | EXPIRED | COD_PENDING | COD_COLLECTED
  webhookVerifiedAt DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerOrderId])
  @@unique([provider, providerOrderId, providerPaymentId])
}

model Shipment {
  id             String   @id @default(cuid())
  orderId        String
  carrier        String?
  trackingNumber String?
  status         String   @default("PENDING") // PENDING | IN_TRANSIT | OUT_FOR_DELIVERY | DELIVERED | EXCEPTION
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ---------------------------------------------------------------- returns / refunds

model ReturnRequest {
  id           String   @id @default(cuid())
  orderId      String
  orderItemId  String
  userId       String?
  reason       String
  status       String   @default("REQUESTED") // REQUESTED | APPROVED | RECEIVED | INSPECTED | REJECTED | COMPLETED
  refundAmountPaise Int @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
}

model Refund {
  id              String   @id @default(cuid())
  returnRequestId String
  provider        String
  providerRefundId String?
  amountPaise     Int
  status          String   @default("INITIATED") // INITIATED | PROCESSED | FAILED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([returnRequestId])
}

// ---------------------------------------------------------------- reviews / wishlist

model Review {
  id                  String    @id @default(cuid())
  productId           String
  userId              String
  rating              Int
  title               String?
  body                String
  isVerifiedPurchase  Boolean   @default(false)
  moderationStatus    String    @default("PENDING") // PENDING | APPROVED | REJECTED
  publishedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, moderationStatus])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  variantId String?
  productId String
  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// ---------------------------------------------------------------- misc

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  status    String   @default("PENDING") // PENDING | CONFIRMED | UNSUBSCRIBED
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("NEW") // NEW | IN_PROGRESS | RESOLVED
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String   // e.g. PRODUCT_UPDATED
  entity    String
  entityId  String?
  diff      Json?
  ip        String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------- inbound email

// Emails received through Resend inbound (webhook email.received events).
// Stores metadata + a truncated body only - never attachment payloads.
model InboundEmail {
  id          String   @id @default(cuid())
  emailId     String   @unique // Resend's email_id (idempotency key for replays)
  from        String
  to          String
  cc          String?
  subject     String
  bodyText    String?
  bodyHtml    String?
  attachments Json?    // filename + content_type metadata ONLY
  status      String   @default("RECEIVED") // RECEIVED | FETCHED | FETCH_FAILED
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------- business notifications

// Durable notification outbox. Every business event (order created, payment
// captured/failed/expired, COD collected, meaningful cart activity) is
// recorded exactly once (unique dedupeKey) and delivered by a best-effort
// flush pass (email via Resend, optional WhatsApp Business Platform).
// Payloads contain order/customer contact details for the business
// notification itself; they are never logged.
model NotificationOutbox {
  id        String    @id @default(cuid())
  type      String // ORDER_CREATED | PAYMENT_SUCCEEDED | PAYMENT_FAILED | PAYMENT_EXPIRED | PAYMENT_LATE | COD_COLLECTED | CART_ACTIVITY
  dedupeKey String    @unique
  status    String    @default("PENDING") // PENDING | SENT | FAILED
  attempts  Int       @default(0)
  lastError String?
  payload   Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sentAt    DateTime?

  @@index([status, createdAt])
}

// ---------------------------------------------------------------- coupons
// Discount rules are validated and calculated on the backend only. All
// money values are INTEGER PAISE. discountValue is a whole percentage (1-90)
// for PERCENT coupons and paise for FIXED coupons; FREE_SHIPPING coupons
// ignore it. minimumOrderPaise is evaluated against the PRE-DISCOUNT
// merchandise subtotal of eligible items (documented, enforced consistently).

enum DiscountType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

model Coupon {
  id            String      @id @default(cuid())
  // normalised to UPPERCASE, trimmed; uniqueness enforced by the database
  code          String      @unique
  internalName  String
  publicDescription String?
  discountType  DiscountType
  discountValue Int
  minimumOrderPaise Int     @default(0)
  maximumDiscountPaise Int?
  startsAt      DateTime    @default(now())
  expiresAt     DateTime?
  isActive      Boolean     @default(true)
  // isPublic: show in the public coupon listing endpoint. Private campaigns
  // (customer-specific, internal) are never exposed publicly.
  isPublic      Boolean     @default(false)
  displayPriority Int       @default(0)
  promoHeadline String?
  totalUsageLimit Int?
  perCustomerUsageLimit Int?
  firstOrderOnly Boolean    @default(false)
  // timesUsed counts ACTIVE redemptions (released ones decrement it), so it
  // always reflects currently-consumed usage.
  timesUsed     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  products   CouponProduct[]
  redemptions CouponRedemption[]
  orders     Order[]        @relation("OrderCoupon")

  @@index([isActive, expiresAt])
  @@index([isPublic, isActive])
}

// Optional per-product eligibility. No rows = all products are eligible.
model CouponProduct {
  couponId  String
  productId String

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@index([productId])
}

// One row per order that redeemed a coupon. A redemption is RESERVED at
// order creation (inside the same transaction, under a FOR UPDATE lock on
// the coupon row) and RELEASED when the attempt fails, expires or the
// order is cancelled - mirroring the inventory reservation lifecycle.
model CouponRedemption {
  id           String   @id @default(cuid())
  couponId     String
  orderId      String   @unique
  userId       String?
  email        String
  discountPaise Int
  createdAt    DateTime @default(now())
  releasedAt   DateTime?
  releasedReason String?

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@index([couponId, releasedAt])
}

// ---------------------------------------------------------------- settings
// Backend-managed business configuration (Settings section). One row per
// settings section, value is the section JSON. Credentials and secrets are
// NEVER stored here - they remain in environment variables / secret
// management; the settings API only reports configured/not-configured.
model BusinessSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}
