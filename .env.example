# ---- Core ----
NODE_ENV=development
PORT=3000
API_BASE_PATH=/api/v1

# ---- CORS: exact origin(s) of the KIEN frontend, comma separated, no trailing slash ----
CORS_ORIGIN=http://localhost:5173

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://kien:kien@localhost:5432/kiensports?schema=public

# ---- Auth ----
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_COST=12

# ---- Payments ----
# One of: mock | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret from the provider dashboard (Razorpay: "webhook secret")
PAYMENT_WEBHOOK_SECRET=change-me

# ---- Frontend URL (used in emails / links) ----
FRONTEND_URL=http://localhost:5173

# ---- Seed-only: initial admin account (set when running `npm run db:seed`) ----
ADMIN_EMAIL=admin@kiensports.com
ADMIN_PASSWORD=change-this-before-seeding
