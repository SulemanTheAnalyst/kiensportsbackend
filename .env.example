# ---- Core ----
NODE_ENV=development
PORT=3000
API_BASE_PATH=/api/v1

# ---- CORS: exact origin(s) of the KIEN frontend, comma separated, no trailing slash ----
CORS_ORIGIN=http://localhost:5173

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://kien:kien@localhost:5432/kiensports?schema=public

# ---- Auth ----
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_COST=12

# ---- Payments ----
# One of: mock | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret from the provider dashboard (Razorpay: "webhook secret")
PAYMENT_WEBHOOK_SECRET=change-me

# ---- Frontend URL (used in emails / links) ----
FRONTEND_URL=http://localhost:5173

# ---- Email (Resend) - see docs/EMAIL.md ----
# REQUIRED IN PRODUCTION for transactional email. Optional locally: when unset,
# email sending is disabled (logged + reported by /health) and the API works.
# API key from the Resend dashboard (re_...). NEVER expose to the frontend.
RESEND_API_KEY=
# Svix signing secret (whsec_...) shown once when creating the inbound webhook
# in the Resend dashboard. This is NOT the API key.
RESEND_WEBHOOK_SECRET=
# Authorized sender on the verified kiensports.com domain.
EMAIL_FROM=KIEN Sports <no-reply@kiensports.com>
# Optional default Reply-To for transactional emails.
EMAIL_REPLY_TO=support@kiensports.com
# Where contact-form notifications and inbound email alerts are sent.
SUPPORT_EMAIL=support@kiensports.com
# Optional: new-order notifications for the business.
BUSINESS_NOTIFICATION_EMAIL=

# ---- Seed-only: initial admin account (set when running `npm run db:seed`) ----
ADMIN_EMAIL=admin@kiensports.com
ADMIN_PASSWORD=change-this-before-seeding
